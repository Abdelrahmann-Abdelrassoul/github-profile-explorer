# Copy to .env.local and fill in real values. .env.local is gitignored.

# GitHub personal access token (classic), `public_repo` scope is enough.
# Raises the REST rate limit from 60/hr to 5,000/hr — required, since every
# page load hits the GitHub API. Create one at:
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Google Gemini API key, used server-side by the Vercel AI SDK (@ai-sdk/google)
# for the profile summary and repo chat. Free tier, no billing required:
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
