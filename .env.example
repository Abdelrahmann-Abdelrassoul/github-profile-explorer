# Copy to .env.local and fill in real values. .env.local is gitignored.

# GitHub personal access token (classic), `public_repo` scope is enough.
# Raises the REST rate limit from 60/hr to 5,000/hr — required, since every
# page load hits the GitHub API. Create one at:
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Groq API key, used server-side by the Vercel AI SDK (@ai-sdk/groq) for the
# profile summary and repo chat. Free tier needs only an email — no credit card:
# https://console.groq.com/keys
#
# The spec originally specified Google Gemini, but its key began returning
# 403 PERMISSION_DENIED and now requires a billable project. Swapping providers
# is one file (lib/server/ai.ts) plus this variable, since all model calls go
# through the AI SDK.
GROQ_API_KEY=
